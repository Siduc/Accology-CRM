# Copy to .env and fill in values. Never commit .env.

ENV=development

AUTH_USERNAME=accountant
AUTH_PASSWORD=change-me
SESSION_SECRET=dev-only-change-me-in-production

# Demo-only visitor login (share these — never the staff AUTH_* above)
# Always anonymised; cannot switch to live data. Leave DEMO_AUTH_PASSWORD empty to disable.
DEMO_AUTH_USERNAME=demo
DEMO_AUTH_PASSWORD=

# X1 daily book = local SQLite crm.db. Comment DATABASE_URL out.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# If DATABASE_URL is unset, local uses crm.db (fast).
# RENDER_DATABASE_URL is only for the 17:00 publish / pull scripts.
# RENDER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require


# Companies House — public data (read)
COMPANIES_HOUSE_API_KEY=

# Companies House — XML Gateway (Software Filing presenter account)
# Apply: https://www.gov.uk/guidance/apply-to-file-with-companies-house-using-software
# CS01 export works without these. Live submit stays off until CH_XML_SUBMIT_LIVE=1.
CH_XML_PRESENTER_ID=
CH_XML_PRESENTER_AUTH=
# CH_XML_PACKAGE_REFERENCE=0000
# CH_XML_GATEWAY_TEST=1
# CH_XML_SUBMIT_LIVE=0

# Companies House — OAuth 2.0 API Filing (web application on Developer Hub)
CH_OAUTH_CLIENT_ID=
CH_OAUTH_CLIENT_SECRET=
# Must be a PUBLIC https URL registered on the Hub web client.
# localhost / 127.0.0.1 is blocked by Companies House (403 Forbidden).
# Local dev: use cloudflared/ngrok, e.g.
# CH_OAUTH_REDIRECT_URI=https://YOUR-TUNNEL.trycloudflare.com/oauth/companies-house/callback
CH_OAUTH_REDIRECT_URI=https://your-app.example.com/oauth/companies-house/callback
# Optional overrides (live defaults):
# CH_OAUTH_IDENTITY_BASE=https://identity.company-information.service.gov.uk
# CH_OAUTH_API_BASE=https://api.company-information.service.gov.uk
# CH_OAUTH_EXTRA_SCOPES=https://api.company-information.service.gov.uk/company/{company_number}/registered-office-address.update

# Selective Outlook → Task push (Power Automate / Outlook button)
# POST /api/v1/tasks/from-email with header: X-API-Key: <this value>
# No browser login required. Aliases: ACCOLOGISE_TASK_PUSH_KEY, TASK_PUSH_API_KEY
TASK_IMPORT_API_KEY=
# Same key: Outlook → Prospect activity + follow-up task + OneDrive proposals
# POST /api/v1/prospecting/from-email  (see Settings → Outlook → Prospect)


# Accologise AI (SpaceXAI / xAI) — server-side only; never expose to browser
# https://console.x.ai → create key. Optional: AI_MODEL=grok-4.5
XAI_API_KEY=
# AI_MODEL=grok-4.5
# AI_ASSISTANT_ENABLED=true
# AI_ASSISTANT_HEURISTIC=true   # command mode without LLM (CH + rules)
# AI_PLAN_SECRET=               # defaults to SESSION_SECRET; signs confirm plans



# Asana
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=
ASANA_PROJECT_GID=

# Xero (practice OAuth — pull books, post journals)
# Create a Web app at https://developer.xero.com/app/manage
# Redirect URI must match exactly (local HTTP):
#   XERO_REDIRECT_URI=http://localhost:8000/oauth/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/oauth/xero/callback
# Optional override. Default matches new-app granular scopes (+ offline_access).
# XERO_SCOPES=offline_access app.connections accounting.settings.read accounting.banktransactions.read accounting.manualjournals accounting.reports.trialbalance.read accounting.reports.profitandloss.read accounting.reports.balancesheet.read

# Sage Business Cloud Accounting (not Sage 50 desktop)
# https://developer.sage.com/accounting
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:8000/oauth/sage/callback
# SAGE_COUNTRY=GB

# QuickBooks Online
# https://developer.intuit.com
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://accology.co/oauth/qbo/callback
# QBO_ENVIRONMENT=production
# QBO_ENVIRONMENT=sandbox

# Microsoft Graph / OneDrive (document management)
# Azure App registration → Web redirect URI must match MS_GRAPH_REDIRECT_URI
# exactly (scheme, host, port, path).
#
# Local uvicorn is HTTP only — use http:// for local development:
#   MS_GRAPH_REDIRECT_URI=http://localhost:8000/oauth/microsoft/callback
# Add that same URI in Azure (Authentication → Web). Azure allows http on localhost.
# Do NOT use https://localhost unless you terminate TLS in front of the app
# (https → bare uvicorn causes ERR_SSL_PROTOCOL_ERROR after Microsoft login).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=http://localhost:8000/oauth/microsoft/callback
# MS_GRAPH_SCOPES=offline_access User.Read Files.ReadWrite Mail.Send Mail.ReadWrite Mail.Read.Shared Mail.ReadWrite.Shared
# MS_GRAPH_MAX_UPLOAD_MB=25
# MS_GRAPH_MAIL_ARCHIVE_FOLDER=archive
# PRACTICE_EMAIL_LIVE=  (defaults to CHASE_LIVE_MODE; set true to send via SMTP without Graph)

# Staff alerts — website contact → CRM notification (always) + optional email
# NOTIFY_WEBSITE_PROSPECT_EMAIL=true
# NOTIFY_ALERT_EMAIL=you@accology.co   # defaults to PRACTICE_EMAIL / SMTP_FROM

# Debt chase (default off)
CHASE_LIVE_MODE=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PRACTICE_NAME=Accologise Practice
